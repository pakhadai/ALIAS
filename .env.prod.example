# MOVLI — єдиний файл конфігурації для репозиторію та VPS
#
# У корені клону на сервері: `.env.prod` (цей файл у git — лише шаблон).
# Скопіюй: cp .env.prod.example .env.prod
#
# Повний опис змінних — README.md § «Конфігурація (env змінні)».
# Рекомендований стек: docker-compose.npm.yml + Nginx Proxy Manager.

# Мережа Docker, у якій сидить NPM (gateway має бути в тій самій мережі).
# Перевір на сервері: docker network ls
NPM_DOCKER_NETWORK=npm_network

# Домен і БД
DOMAIN=movli.yourdomain.com
POSTGRES_DB=alias
POSTGRES_USER=alias
POSTGRES_PASSWORD=change_me_strong_password

# Безпека
JWT_SECRET=change_me_very_long_random_string_at_least_32_chars
# ADMIN_ALLOWED_IPS=10.8.0.0/24
# ADMIN_ALLOWED_EMAILS=owner@yourdomain.com
# ADMIN_API_KEY=
TRUST_PROXY_HOPS=1

# OAuth / платежі
GOOGLE_CLIENT_ID=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=https://movli.yourdomain.com/api/bot/webhook
TELEGRAM_WEBHOOK_SECRET=change_me_random_32_chars
FRONTEND_URL=https://movli.yourdomain.com

# CORS і клієнтська збірка (зазвичай = публічний https://DOMAIN)
CORS_ORIGIN=https://movli.yourdomain.com
VITE_SERVER_URL=https://movli.yourdomain.com
# Telegram Mini App invite deep-link (lobby "Invite friends"): https://t.me/<bot_username>?startapp=lobby_<code>
VITE_TG_APP_LINK=https://t.me/aliasmaster_bot

# Публікація gateway для NPM: за замовчуванням лише localhost (NPM у Docker дістає gateway по імені).
# Якщо NPM не в Docker — інколи потрібно 0.0.0.0:9080 (не відкривай публічно без файрволу).
GATEWAY_PUBLISH=127.0.0.1:9080

# Let's Encrypt (лише для docker-compose.prod.yml — власний nginx+certbot, без NPM)
# SSL_EMAIL=admin@yourdomain.com

# Sentry (опційно)
# SENTRY_DSN=
# VITE_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
